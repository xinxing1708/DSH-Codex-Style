{
  "name": "@xinxing1708/dsh-codex-style",
  "version": "0.2.1",
  "description": "DSH 的 Codex 风格深色界面插件",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./behavior": "./lib/behavior.js",
    "./behavior/locale/*.json": "./locale/behavior/*.json",
    "./body": "./lib/body.js",
    "./body/locale/*.json": "./locale/body/*.json",
    "./header": "./lib/header.js",
    "./header/locale/*.json": "./locale/header/*.json",
    "./navigation": "./lib/navigation.js",
    "./navigation/locale/*.json": "./locale/navigation/*.json",
    "./image-annotations": "./lib/image-annotations.js",
    "./image-annotations/locale/*.json": "./locale/image-annotations/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/test-install.mjs scripts/test-update.mjs scripts/test-client.mjs scripts/test-skills.mjs scripts/test-image-annotations.mjs scripts/test-image-annotations-host.mjs scripts/test-image-annotations-integration.mjs scripts/test-navigation.mjs scripts/test-host-signatures.mjs scripts/test-community-environment.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "prompts",
    "locale",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "install.cmd",
    "scripts/install.mjs",
    "scripts/rollback.mjs",
    "licenses"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinxing1708/DSH-Codex-Style.git"
  },
  "homepage": "https://github.com/xinxing1708/DSH-Codex-Style#readme",
  "bugs": {
    "url": "https://github.com/xinxing1708/DSH-Codex-Style/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "js-yaml": "4.3.2"
  }
}
